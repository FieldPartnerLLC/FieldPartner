# Server
PORT=8080
PUBLIC_API_URL=https://api.example.com
PORTAL_URL=https://portal.example.com
JWT_SECRET=change-me-to-64-random-chars
AGENT_SERVICE_TOKEN=change-me-shared-with-agent
DATABASE_URL=postgres://fieldpartner:fieldpartner@localhost:5432/fieldpartner

# LiveKit Cloud (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=fieldpartner-agent

# Object storage (AWS S3 or any S3-compatible: Cloudflare R2, Backblaze B2)
S3_BUCKET=fieldpartner-media
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Record a cloud copy of each consented visit through LiveKit Egress (true/false)
CLOUD_RECORDING=true

# Gemini (paid tier) for reports
GOOGLE_API_KEY=
REPORT_MODEL=gemini-3.5-flash

# Twilio for WhatsApp and SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+15555550100
TWILIO_WHATSAPP_FROM=whatsapp:+15555550100

# SMTP for emailed reports
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FieldPartner <reports@example.com>"

# Escalation: seconds before the next expert is paged
ESCALATION_TIMEOUT_SECONDS=120
