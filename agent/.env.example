# Same LiveKit project as the backend
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Gemini (paid tier)
GOOGLE_API_KEY=
# Backend the agent reports to, and the shared service token
BACKEND_URL=http://localhost:8080
AGENT_SERVICE_TOKEN=
# Optional tuning
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Puck
SAFETY_MODEL=gemini-3.5-flash-lite
SAFETY_INTERVAL_SECONDS=5
FOLLOW_UP_SECONDS=20
AGENT_NAME=fieldpartner-agent
