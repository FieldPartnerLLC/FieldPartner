# FieldPartner local settings. Copy to config.env and fill in the three blanks.
# Never commit config.env or paste these values into chat.

# 1. LiveKit Cloud (cloud.livekit.io > your project > Settings > API Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 2. Gemini API key (aistudio.google.com/apikey, billing on). Live voice and camera.
GOOGLE_API_KEY=

# 3. Claude API key (console.anthropic.com > API Keys). Senior expert answers, reports, lessons.
#    Optional: without it Gemini does everything.
ANTHROPIC_API_KEY=

# Filled in automatically by scripts/setup-mac.sh
JWT_SECRET=
AGENT_SERVICE_TOKEN=
PUBLIC_API_URL=
PORTAL_URL=

# Optional: WhatsApp/SMS paging through Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Optional: S3 storage and cloud recording (leave empty to store files on this Mac)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CLOUD_RECORDING=false
