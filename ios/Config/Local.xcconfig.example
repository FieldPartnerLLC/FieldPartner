// Copy to Local.xcconfig and fill in. Local.xcconfig is not committed.

// Your Apple Developer Team ID (Xcode > Settings > Accounts > your team). 10 characters.
DEVELOPMENT_TEAM = ABCDE12345

// Must be unique to you, e.g. com.yourname.fieldpartner
FP_BUNDLE_ID = com.ironrim.fieldpartner

// Backend URL the phone talks to: the live server. For a server on your Mac use its Wi-Fi IP,
// e.g. http:/$()/192.168.1.20:8080 (the $() keeps xcconfig from treating // as a comment)
FP_API_BASE_URL = https:/$()/fieldpartner-api.onrender.com

// Meta Wearables Developer Center values. Leave as 0 while the Meta AI app has Developer Mode on.
META_APP_ID = 0
CLIENT_TOKEN = 0

// Glasses video over Wi-Fi (Hotspot entitlement). Needs a paid Apple Developer team ($99).
// Free Apple ID (Personal Team): leave empty. The app installs and runs, but the glasses send no video.
// Paid team: FP_ENTITLEMENTS = FieldPartner/FieldPartner.entitlements
FP_ENTITLEMENTS =
