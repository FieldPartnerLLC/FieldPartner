<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed so the app can talk to the backend on your Mac during testing.
     For the Play Store build, put the backend behind https and set cleartextTrafficPermitted="false". -->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
